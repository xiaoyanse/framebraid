{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameBraid decode hardware report v1",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "state",
    "selection",
    "actual_backend",
    "last_failure",
    "stream_verified"
  ],
  "properties": {
    "schema": {
      "const": "framebraid.decode-hardware/1"
    },
    "kind": {
      "enum": [
        "probe",
        "decoder",
        "source"
      ]
    },
    "state": {
      "enum": [
        "not_probed",
        "probe_complete",
        "initialized",
        "verified",
        "recovered_cpu",
        "failed",
        "closed",
        "idle",
        "initializing",
        "waiting_keyframe",
        "waiting_resource",
        "closing"
      ]
    },
    "actual_backend": {
      "enum": [
        null,
        "ffmpeg-cpu",
        "ffmpeg-d3d11va",
        "ffmpeg-dxva2",
        "image-cpu"
      ]
    },
    "stream_verified": {
      "type": "boolean"
    },
    "completed_at_ms": {
      "type": "integer"
    },
    "source_generation": {
      "type": "integer",
      "minimum": 1
    },
    "config_generation": {
      "type": "integer",
      "minimum": 1
    },
    "last_failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "InvalidInput",
            "AllocationFailed",
            "FrameTooLarge",
            "Drained"
          ]
        },
        {
          "type": "object",
          "required": [
            "Runtime"
          ],
          "properties": {
            "Runtime": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "selection": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "policy",
            "selected",
            "attempts",
            "fallback",
            "elapsed_ms"
          ],
          "properties": {
            "policy": {
              "enum": [
                "SoftwareOnly",
                "PreferHardware"
              ]
            },
            "elapsed_ms": {
              "type": "integer",
              "minimum": 0
            },
            "selected": {
              "type": [
                "object",
                "null"
              ]
            },
            "attempts": {
              "type": "array",
              "maxItems": 16
            },
            "fallback": {
              "type": [
                "object",
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "decode_generation": {
      "type": "integer",
      "minimum": 1
    },
    "last_status": {
      "type": [
        "integer",
        "null"
      ]
    },
    "requested_policy": {
      "enum": [
        0,
        1
      ]
    },
    "effective_policy": {
      "enum": [
        0,
        1
      ]
    },
    "decoder_active": {
      "type": "boolean"
    },
    "policy_locked": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "source"
          }
        }
      },
      "then": {
        "required": [
          "requested_policy",
          "effective_policy",
          "decoder_active",
          "policy_locked",
          "decode_generation",
          "source_id",
          "source_generation",
          "config_generation",
          "last_status"
        ]
      }
    }
  ]
}
